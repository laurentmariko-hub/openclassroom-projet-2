@startuml sequence-diagram
title Olympic Games Starter - Diagramme de séquence : parcours utilisateur

actor Utilisateur as User
participant "Router" as Router
participant "OlympicGameComponent" as OlympicGame
participant "OlympicService" as Service
participant "ChartService" as ChartSvc
participant "HttpClient" as Http
participant "olympic.json" as Json
participant "Chart.js" as Chart

== Étape 1: Chargement de la page d'accueil ==
User -> Router : navigation vers "/"
Router -> OlympicGame : instanciation du composant
activate OlympicGame

OlympicGame -> Service : getParticipatingCountries()
activate Service
Service -> Http : GET olympic.json
activate Http
Http -> Json : requête HTTP
activate Json
Json --> Http : [Country[], ...]
deactivate Json
Http --> Service : Observable<Country[]>
deactivate Http

Service --> OlympicGame : données typées
deactivate Service

OlympicGame -> OlympicGame : calcul des KPIs\n(numberOfCountries, numberOfJOs)
OlympicGame -> OlympicGame : construction des arrays\n(countryNames, medals)

OlympicGame -> ChartSvc : getPieChart(countryNames, medals)
activate ChartSvc
ChartSvc -> Chart : création pie chart
activate Chart
Chart --> ChartSvc : Chart instance
deactivate Chart
ChartSvc --> OlympicGame : Chart configuré
deactivate ChartSvc

OlympicGame --> User : affichage pie chart + KPIs
deactivate OlympicGame

== Étape 2: Navigation vers détail pays ==
User -> Chart : clic sur part du pie chart
Chart -> OlympicGame : événement click
activate OlympicGame
OlympicGame -> OlympicGame : extraction countryName
OlympicGame -> Router : navigate(['country', name])
deactivate OlympicGame

== Étape 3: Chargement page pays ==
participant "SingleCountryComponent" as SingleCountry
Router -> SingleCountry : instanciation
activate SingleCountry

SingleCountry -> SingleCountry : lecture route params ('name')

SingleCountry -> Service : getCountryByName(name)
activate Service
Service -> Http : GET olympic.json
activate Http
Http -> Json : requête HTTP
activate Json
Json --> Http : [Country[], ...]
deactivate Json
Http --> Service : Observable<Country[]>
deactivate Http

Service -> Service : find() par name
Service --> SingleCountry : Observable<Country>
deactivate Service

SingleCountry -> SingleCountry : extraction données pays\n(years, medals, athletes)
SingleCountry -> SingleCountry : calcul des KPIs

SingleCountry -> ChartSvc : getLineChart(years, medals)
activate ChartSvc
ChartSvc -> Chart : création line chart
activate Chart
Chart --> ChartSvc : Chart instance
deactivate Chart
ChartSvc --> SingleCountry : Chart configuré
deactivate ChartSvc

SingleCountry --> User : affichage line chart + KPIs
deactivate SingleCountry

@enduml
