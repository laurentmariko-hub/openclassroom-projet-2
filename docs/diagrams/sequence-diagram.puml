@startuml sequence-diagram
title Olympic Games Starter - Diagramme de séquence : parcours utilisateur

actor Utilisateur as User
participant "Router" as Router
participant "OlympicGameComponent" as OlympicGame
participant "SingleCountryComponent" as SingleCountry
participant "HeaderComponent" as Header
participant "OlympicService" as Service
participant "ChartService" as ChartSvc
participant "ChartFactory" as Factory
participant "HttpClient" as Http
participant "olympic.json" as Json
participant "Chart.js" as Chart

== Étape 1: Chargement de la page d'accueil ==
User -> Router : navigation vers "/"
Router -> OlympicGame : instanciation du composant
activate OlympicGame

OlympicGame -> Service : getParticipatingCountries()
activate Service
Service -> Http : GET olympic.json
activate Http
Http -> Json : requête HTTP
activate Json
Json --> Http : CountryInterface[]
deactivate Json
Http --> Service : Observable<CountryInterface[]>
deactivate Http
Service -> Service : map → new Country(name, participations)
Service --> OlympicGame : Observable<Country[]>
deactivate Service

OlympicGame -> Service : getNumberOfCountries(countries)
Service --> OlympicGame : numberOfCountries
OlympicGame -> Service : getNumberOfJOs(countries)
Service --> OlympicGame : numberOfJOs
OlympicGame -> Service : getCountryNames(countries)
Service --> OlympicGame : countryNames
OlympicGame -> Service : getSumOfAllMedalsYears(countries)
Service --> OlympicGame : sumOfAllMedalsYears

OlympicGame -> ChartSvc : getPieChart(countryNames, sumOfAllMedalsYears)
activate ChartSvc
ChartSvc -> Factory : build(labels, data, 'pieChart', router)
activate Factory
Factory -> Chart : new Chart("DashboardPieChart", config)
activate Chart
Chart --> Factory : Chart instance
deactivate Chart
Factory --> ChartSvc : AppChart
deactivate Factory
ChartSvc --> OlympicGame : AppChart
deactivate ChartSvc

OlympicGame -> OlympicGame : indicators = [countries, JOs]
OlympicGame -> Header : title, indicators
activate Header
Header --> User : affichage titre + indicateurs
deactivate Header
OlympicGame --> User : affichage pie chart
deactivate OlympicGame

== Étape 2: Navigation vers détail pays ==
User -> Chart : clic sur une part du pie chart
Chart -> Factory : onClick(event)
activate Factory
Factory -> Factory : getElementsAtEventForMode() → countryName
Factory -> Router : navigate(['country', countryName])
deactivate Factory
Router -> SingleCountry : instanciation (route 'country/:name')

== Étape 3: Chargement page pays ==
activate SingleCountry
SingleCountry -> SingleCountry : lecture route params ('name')

SingleCountry -> Service : getCountryByName(name)
activate Service
Service -> Http : GET olympic.json
activate Http
Http -> Json : requête HTTP
activate Json
Json --> Http : CountryInterface[]
deactivate Json
Http --> Service : Observable<CountryInterface[]>
deactivate Http
Service -> Service : map → Country[] puis filter() par name
Service --> SingleCountry : Observable<Country | undefined>
deactivate Service

SingleCountry -> SingleCountry : calcul des KPIs\n(entries, medals, athletes)
SingleCountry -> SingleCountry : title = "Pays: " + name\nou "Non défini"
SingleCountry -> SingleCountry : extraction (years, medals)

SingleCountry -> ChartSvc : getLineChart(years, medals)
activate ChartSvc
ChartSvc -> Factory : build(labels, data, 'lineChart', router)
activate Factory
Factory -> Chart : new Chart("countryChart", config)
activate Chart
Chart --> Factory : Chart instance
deactivate Chart
Factory --> ChartSvc : AppChart
deactivate Factory
ChartSvc --> SingleCountry : AppChart
deactivate ChartSvc

SingleCountry -> Header : title, indicators
activate Header
Header --> User : affichage titre + indicateurs
deactivate Header
SingleCountry --> User : affichage line chart
deactivate SingleCountry

== Étape 4: Erreur de chargement ==
note over OlympicGame, Service
  Si l'appel HTTP échoue (OlympicGameComponent),
  l'utilisateur est redirigé vers /not-found.
end note
OlympicGame -> Router : navigate(['/not-found'])
Router -> Router : route '**' / 'not-found' → NotFoundComponent

@enduml
