@startuml class-diagram
title Olympic Games Starter - Diagramme de classes (refactorisé)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "app (Root)" {
  class AppModule <<NgModule>> {
    +declarations: [AppComponent, NotFoundComponent]
    +imports: [BrowserModule, AppRoutingModule]
    +providers: [provideHttpClient()]
    +bootstrap: [AppComponent]
  }

  class AppRoutingModule <<NgModule>> {
    +routes: Routes
  }

  class AppComponent <<Component>> {
    +selector: app-root
  }
}

package "components (Standalone)" {
  class OlympicGameComponent <<Component>> {
    +selector: app-olympic-game
    +standalone: true
    -olympicService: OlympicService
    -chartService: ChartService
    +countries: Country[]
    +countryNames: string[]
    +pieChart: Chart<any, any, any>
    +numberOfCountries: number
    +numberOfJOs: number
    +titlePage: string
    --
    +ngOnInit(): void
  }

  class CountryListComponent <<Component>> {
    +selector: app-country-list
    +standalone: true
    -olympicService: OlympicService
    +countries: Country[]
    --
    +ngOnInit(): void
  }

  class SingleCountryComponent <<Component>> {
    +selector: app-single-country
    +standalone: true
    -olympicService: OlympicService
    -chartService: ChartService
    -route: ActivatedRoute
    +country: Country
    +lineChart: Chart<any, any, any>
    +totalEntries: number
    +totalMedals: number
    +totalAthletes: number
    +titlePage: string
    --
    +ngOnInit(): void
  }
}

package "pages (Standalone)" {
  class NotFoundComponent <<Component>> {
    +selector: app-not-found
    +standalone: true
  }
}

package "services" {
  class OlympicService <<Injectable>> {
    -olympicUrl: string
    -http: HttpClient
    --
    +getParticipatingCountries(): Observable<Country[]>
    +getCountries(): Observable<Country[]>
    +getNumberOfCountries(): Observable<number>
    +getCountryByName(name: string): Observable<Country>
    +getTotalJOs(): Observable<number>
  }

  class ChartService <<Injectable>> {
    -router: Router
    --
    +getLineChart(labels: string[], data: number[]): Chart
    +getPieChart(labels: string[], data: number[]): Chart
  }
}

package "models" {
  class Country {
    +name: string
    +participations: Participation[]
    --
    +getTotalEntries(): number
    +getTotalMedals(): number
    +getTotalAthletes(): number
    +getParticipationByYear(year: number): Participation
  }

  class Participation {
    +id: string
    +year: number
    +city: string
    +athleteCount: number
    +medalsCount: number
  }

  class ChartFactory <<factory>> {
    +{static} build(labels: string[], data: number[], chartType: chartType, router: Router): Chart
  }

  class ChartType <<enum>> {
    lineChart
    pieChart
  }
}

OlympicGameComponent --> OlympicService : injects
OlympicGameComponent --> ChartService : injects
OlympicGameComponent --> CountryListComponent : imports
OlympicGameComponent ..> Country : uses
OlympicGameComponent ..> "Chart.js" : crée pie chart

CountryListComponent --> OlympicService : injects
CountryListComponent ..> Country : affiche liste

SingleCountryComponent --> OlympicService : injects
SingleCountryComponent --> ChartService : injects
SingleCountryComponent ..> Country : uses
SingleCountryComponent ..> "Chart.js" : crée line chart

AppModule *-- AppComponent : bootstrap
AppModule ..> AppRoutingModule : imports
AppModule *-- NotFoundComponent : declarations

AppRoutingModule ..> OlympicGameComponent : route ""
AppRoutingModule ..> SingleCountryComponent : route "country/:name"
AppRoutingModule ..> NotFoundComponent : route "not-found, **"

OlympicService --> HttpClient : injects
OlympicService ..> Country : retourne
OlympicService ..> Participation : retourne

ChartService --> Router : injects
ChartService --> ChartFactory : utilise
ChartFactory --> ChartType : utilise

Country *-- Participation : composition
Country "1" -- "*" Participation : participations

@enduml
