@startuml class-diagram
title Olympic Games Starter - Diagramme de classes (code source complet)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam classFontSize 12
skinparam linetype ortho

package "app (racine)" {
  class AppModule <<NgModule>> {
    +declarations: [AppComponent, NotFoundComponent]
    +imports: [BrowserModule, AppRoutingModule]
    +providers: [provideHttpClient()]
    +bootstrap: [AppComponent]
  }

  class AppRoutingModule <<NgModule>> {
    +routes: Routes
  }

  class AppComponent <<Component>> {
    +selector: app-root
  }
}

package "pages" {
  class NotFoundComponent <<Component>> {
    +selector: app-not-found
  }
}

package "components" {
  class OlympicGameComponent <<Standalone Component>> {
    +selector: app-olympic-game
    -olympicService: OlympicService
    -chartService: ChartService
    -router: Router
    +Countries: Country[]
    +totalEntries: number
    +countries: Country[]
    +countryNames: string[]
    +pieChart: AppChart
    +numberOfCountries: number
    +numberOfJOs: number
    +medals: number[][]
    +sumOfAllMedalsYears: number[]
    +errorMessage: string
    +title: string
    +indicators: Indicator[]
    --
    +ngOnInit(): void
  }

  class SingleCountryComponent <<Standalone Component>> {
    +selector: app-single-country
    -olympicService: OlympicService
    -chartService: ChartService
    -route: ActivatedRoute
    +country: Country
    +totalEntries: number
    +totalMedals: number
    +totalAthletes: number
    +titlePage: string
    +lineChart: AppChart
    +title: string
    +indicators: Indicator[]
    --
    +ngOnInit(): void
  }

}

package "header" {
  class HeaderComponent <<Standalone Component>> {
    +selector: app-header
    +title: InputSignal<string | undefined>
    +indicators: InputSignal<Indicator[] | undefined>
  }
}

package "services" {
  class OlympicService <<Injectable>> {
    -olympicUrl: string
    +countries: Country[]
    +numberOfCountries: number
    +countryNames: string[]
    -http: HttpClient
    --
    +getParticipatingCountries(): Observable<Country[]>
    +getNumberOfCountries(countries: Country[]): number
    +getCountryNames(countries: Country[]): string[] | undefined
    +getCountryByName(name: string): Observable<Country | undefined>
    +getTotalJOs(countries: Country[]): number
    +getSumOfAllMedalsYears(countries: Country[]): number[]
    +getNumberOfJOs(countries: Country[]): number
    +getTitlePage(): string
  }

  class ChartService <<Injectable>> {
    -router: Router
    --
    +getLineChart(labels: string[], data: number[]): AppChart
    +getPieChart(labels: string[], data: number[]): AppChart
  }
}

package "models" {
  class Country {
    +name: string
    +participations: Participation[]
    --
    +getTotalEntries(): number
    +getTotalMedals(): number
    +getTotalAthletes(): number
    +getParticipationByYear(year: number): Participation | undefined
  }

  class Participation {
    +id: string
    +year: number
    +city: string
    +athleteCount: number
    +medalsCount: number
  }

  interface CountryInterface {
    +id: number
    +country: string
    +participations: Participation[]
  }

  class Indicator {
    +label: string
    +value: number
  }

  class ChartFactory <<factory>> {
    -{static} buildChartLineChart(years: string[], medals: number[]): Chart
    -{static} buildPieChart(sumOfAllMedalsYears: number[], countries: string[], router: Router): AppChart
    +{static} build(labels: string[], data: number[], chartType: chartType, router: Router): AppChart
  }

  class chartType <<type>> {
    'lineChart' | 'pieChart'
  }

  class AppChart <<type>> {
    Chart<'line', number[], string> | Chart<'pie', number[], string>
  }
}

package "externes (Angular / Chart.js)" {
  class Router <<external>>
  class HttpClient <<external>>
  class ActivatedRoute <<external>>
  class Chart <<external>>
}

' Racine et routage
AppModule *-- AppComponent : bootstrap
AppModule ..> AppRoutingModule : imports
AppModule ..> NotFoundComponent : declarations
AppRoutingModule ..> OlympicGameComponent : route ""
AppRoutingModule ..> SingleCountryComponent : route "country/:name"
AppRoutingModule ..> NotFoundComponent : route "not-found, **"

' Composants
OlympicGameComponent --> OlympicService : injects
OlympicGameComponent --> ChartService : injects
OlympicGameComponent --> Router : injects
OlympicGameComponent --> HeaderComponent : imports
OlympicGameComponent ..> Indicator : utilise
OlympicGameComponent ..> Country : utilise

SingleCountryComponent --> OlympicService : injects
SingleCountryComponent --> ChartService : injects
SingleCountryComponent --> ActivatedRoute : injects
SingleCountryComponent --> HeaderComponent : imports
SingleCountryComponent ..> Indicator : utilise
SingleCountryComponent ..> Country : utilise

HeaderComponent ..> Indicator : affiche

' Services
OlympicService --> HttpClient : injects
OlympicService ..> Country : retourne
OlympicService ..> CountryInterface : mappe
OlympicService ..> Participation : utilise

ChartService --> Router : injects
ChartService ..> ChartFactory : utilise
ChartService ..> AppChart : retourne

' Modèles
ChartFactory ..> chartType : paramètre
ChartFactory ..> AppChart : retourne
ChartFactory ..> Chart : crée
ChartFactory ..> Router : navigation

Country "1" *-- "*" Participation : participations
CountryInterface ..> Participation : participations

@enduml
